# MongoDB connection string. Leave empty to use a temporary in-memory database.
# Atlas example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/stub
MONGO_URI=

PORT=5000

# Development only (React dev server runs separately on :5173).
# In production leave both empty — the server serves the built client itself.
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
